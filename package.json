{
  "name": "dika-ai-marketing-villa-hq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Head of Digital Marketing 3D Villa AI-Agent HQ with Hermes Sync, Multi-Agent Workflows & Two-Way Reminders",
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c cyan,magenta \"tsx watch --ignore ./data/** --ignore ./hermes_workspace/** --ignore ./dist/** server/index.ts\" \"vite\"",
    "server": "tsx server/index.ts",
    "client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@react-three/drei": "9.117.3",
    "@react-three/fiber": "8.17.10",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "multer": "^1.4.5-lts.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
